<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <title>Amigo Secreto</title>

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      font-family: Arial, sans-serif;
    }

    body {
      background: #e9ecf3;
      display: flex;
      justify-content: center;
      align-items: center;
      min-height: 100vh;
    }

    .container {
      width: 800px;
      background: white;
      border-radius: 20px;
      overflow: hidden;
      box-shadow: 0 10px 30px rgba(0,0,0,0.2);
    }

    /* HEADER */
    .header {
      background: #fff64b;
      color: rgb(0, 240, 24);
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 30px;
    }

    .header h1 {
      font-size: 40px;
      font-style: italic;
    }

    .header img {
      width: 220px;
    }

    /* CONTENT */
    .content {
      padding: 40px;
      text-align: center;
      background: #fff8ef;
    }

    .content h2 {
      color: #000000;
      margin-bottom: 20px;
      font-size: 28px;
    }

    .input-area {
      display: flex;
      justify-content: center;
      margin-bottom: 20px;
    }

    input {
      width: 60%;
      padding: 12px;
      border: 2px solid #ccc;
      border-radius: 25px 0 0 25px;
      outline: none;
      font-size: 16px;
    }

    .btn-add {
      padding: 12px 20px;
      border: none;
      background: #ccc;
      cursor: pointer;
      border-radius: 0 25px 25px 0;
      font-weight: bold;
    }

    .btn-add:hover {
      background: #b5b5b5;
    }

    ul {
      list-style: none;
      margin-top: 20px;
    }

    li {
      background: #f1f1f1;
      margin: 5px auto;
      padding: 10px;
      width: 60%;
      border-radius: 10px;
      border-left: 5px solid #851313;
    }

    .btn-draw {
      margin-top: 30px;
      background: #87ff2b;
      color: white;
      border: none;
      padding: 15px 30px;
      font-size: 18px;
      border-radius: 30px;
      cursor: pointer;
      box-shadow: 0 5px 10px rgba(0,0,0,0.2);
    }

    .btn-draw:hover {
      background: #e85c1f;
    }

    .result {
      margin-top: 20px;
      font-size: 22px;
      font-weight: bold;
      color: green;
    }

    .error {
      color: red;
      margin-top: 10px;
    }
  </style>
</head>

<body>

<div class="container">

  <!-- HEADER -->
  <div class="header">
    <h1>Amigo Secreto</h1>
   
    <!-- coloque sua imagem aqui -->
    <img src="rico.png" alt="ilustração">
  </div>

  <!-- CONTENT -->
  <div class="content">

    <h2>Digite o nome dos seus amigos</h2>

    <div class="input-area">
      <input type="text" id="nameInput" placeholder="Digite um nome">
      <button class="btn-add" onclick="addName()">Adicionar</button>
    </div>

    <p class="error" id="error"></p>

    <ul id="list"></ul>

    <button class="btn-draw" onclick="draw()">▶ Sortear amigo</button>

    <div class="result" id="result"></div>

  </div>

</div>

<script>
  const list = [];

  function addName() {
    const input = document.getElementById("nameInput");
    const name = input.value.trim();
    const error = document.getElementById("error");

    error.textContent = "";

    if (name === "") {
      error.textContent = "Digite um nome válido!";
      return;
    }

    list.push(name);
    input.value = "";
    updateList();
  }

  function updateList() {
    const ul = document.getElementById("list");
    ul.innerHTML = "";

    list.forEach((name) => {
      const li = document.createElement("li");
      li.textContent = name;
      ul.appendChild(li);
    });
  }

  function draw() {
    const result = document.getElementById("result");

    if (list.length === 0) {
      result.style.color = "red";
      result.textContent = "Adicione participantes primeiro!";
      return;
    }

    const random = Math.floor(Math.random() * list.length);
    const winner = list[random];

    result.style.color = "green";
    result.textContent = "🎉 Sorteado: " + winner;
  }
</script>

</body>
</html>
